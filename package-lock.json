{
  "name": "kervix",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "kervix",
      "license": "Apache-2.0",
      "workspaces": [
        "tools/*",
        "host/*",
        "spikes/*",
        "tests/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "host/shared": {
      "name": "@kervix/shared",
      "license": "Apache-2.0"
    },
    "node_modules/@decionis/verify": {
      "version": "0.5.0",
      "resolved": "https://registry.npmjs.org/@decionis/verify/-/verify-0.5.0.tgz",
      "integrity": "sha512-utOT2uw6UVqsvjFDjYIiIjxg+LWTjaC2fyRVjaKWrLAYKBSK1gLbtW4e1NY0XPC5a5uFqXNelAqVLEyJ2v70MA==",
      "license": "Apache-2.0",
      "bin": {
        "decionis-verify": "dist/cli.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@kervix/codegen": {
      "resolved": "tools/codegen",
      "link": true
    },
    "node_modules/@kervix/conformance": {
      "resolved": "tests/conformance",
      "link": true
    },
    "node_modules/@kervix/shared": {
      "resolved": "host/shared",
      "link": true
    },
    "node_modules/@kervix/spike-s5-aac": {
      "resolved": "spikes/s5-aac",
      "link": true
    },
    "node_modules/yaml": {
      "version": "2.9.1",
      "resolved": "https://registry.npmjs.org/yaml/-/yaml-2.9.1.tgz",
      "integrity": "sha512-3NxN8+78OdzbT7C/WjGsyfPAtJaN3FNDsWxv7Y7mcDsT/oOmgW8BpyQQFFBnvZE3j9Y2Sdz1ULFLezL7Eb2yFw==",
      "license": "ISC",
      "bin": {
        "yaml": "bin.mjs"
      },
      "engines": {
        "node": ">= 14.6"
      },
      "funding": {
        "url": "https://github.com/sponsors/eemeli"
      }
    },
    "spikes/s5-aac": {
      "name": "@kervix/spike-s5-aac",
      "license": "Apache-2.0",
      "dependencies": {
        "@decionis/verify": "0.5.0"
      }
    },
    "tests/conformance": {
      "name": "@kervix/conformance",
      "license": "Apache-2.0",
      "dependencies": {
        "@decionis/verify": "0.5.0"
      }
    },
    "tools/codegen": {
      "name": "@kervix/codegen",
      "license": "Apache-2.0",
      "dependencies": {
        "yaml": "^2.6.0"
      }
    }
  }
}
