{
  "name": "kervix",
  "private": true,
  "description": "Kernel-enforced execution authority for software-defined vehicles on QNX 8.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "tools/*",
    "host/*",
    "spikes/*",
    "tests/*"
  ],
  "scripts": {
    "codegen": "node tools/codegen/codegen.mjs",
    "codegen:check": "node tools/codegen/codegen.mjs --check",
    "spike:s5": "npm run -w spikes/s5-aac start",
    "conformance": "npm run -s -w tests/conformance intent"
  }
}
